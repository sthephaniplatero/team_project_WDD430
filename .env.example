# Copy this file to .env.local and fill in the values. Never commit .env.local.

# MongoDB Atlas connection string. It must include the database name "viable":
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/viable?retryWrites=true&w=majority
MONGODB_URI=

# Auth.js secret (random 32 bytes, base64). Generate it with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Only needed outside Vercel
AUTH_URL=http://localhost:3000
